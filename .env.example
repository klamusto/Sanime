# ---------------------------------------------------------------------------
# Sanime — runtime configuration (all optional, sane defaults are built in)
# ---------------------------------------------------------------------------

# Upstream content API.
ANIMETOM_API_BASE=https://api.animetom.live/api

# Identity the media relay wears when it fetches video from the upstream CDN.
# AnimeTom's R2 bucket answers 401 to foreign referers — this is what makes the
# brand-new AnimeTom-hosted episodes playable from your own domain.
UPSTREAM_SITE=https://animetom.live
# UPSTREAM_UA="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 ..."

# Signs /api/stream + /api/embed URLs so nobody can use them as an open proxy.
# CHANGE THIS to a long random string in production.
STREAM_SECRET=change-me-to-a-long-random-string

# on   = always relay video through this server (most reliable, most bandwidth)
# auto = relay only hosts known to block foreign origins (default)
# off  = never relay (browser talks to the CDN directly)
STREAM_PROXY=auto

# Set to 0 to skip the server-side "is this source alive?" checks on watch pages.
STREAM_PROBE=1

# Public site URL (used for metadata, sitemap and CORS probing).
NEXT_PUBLIC_SITE_URL=https://sanime.app
NEXT_PUBLIC_SITE_NAME=Sanime

# Only needed if you use the drizzle/postgres scaffolding.
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
